PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=faind
DB_PASSWORD=faind
DB_NAME=faind

# backend(Java)의 faind.jwt.secret과 반드시 같은 값이어야 한다 — 두 서비스가 같은 서명키로
# JWT를 신뢰한다.
JWT_SECRET=faind-local-development-secret-key-change-in-production-0123456789

# backend가 이 서버의 /webhook/* 를 호출할 때 실어 보내는 내부 토큰. 비워두면 검증을 건너뛴다(로컬 기본값).
INTERNAL_WEBHOOK_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174
